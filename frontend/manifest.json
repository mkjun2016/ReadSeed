{
  "manifest_version": 3,
  "name": "ReadSeed",
  "version": "0.5.0",
  "description": "어려운 낱말에 밑줄을 긋고, 누르면 읽는 법과 쉬운 뜻을 보여 주는 한국어 읽기 보조 확장 프로그램",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ReadSeed 도구 막대 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://readseed.online/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "permissions": ["storage", "activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["toolbar/toolbar.html", "toolbar/toolbar.css", "toolbar/toolbar.js"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
