# 로컬 한국어기초사전에 없는 단어를 위한 보조 Open API 키 (선택)
KRDICT_API_KEY=

# 로컬 한국어기초사전에 없는 단어를 위한 보조 Open API 키 (선택)
URIMALSAM_API_KEY=

# 선택: 문맥 기반 쉬운 말 풀이 선택. Claude API를 쓸 경우 다음 세 값을 설정한다.
# GLOSS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GLOSS_LLM_MODEL=claude-haiku-4-5-20251001

# OpenAI 호환 Chat Completions API를 쓸 경우 아래 세 값을 설정한다.
# 세 값이 모두 없으면 문맥·난이도 판단을 할 수 없으므로 Overlay 풀이를 표시하지 않는다.
GLOSS_LLM_PROVIDER=
GLOSS_LLM_API_URL=
GLOSS_LLM_API_KEY=
# 기본 0.85. 이보다 낮은 LLM 확신은 주석을 표시하지 않는다.
GLOSS_LLM_MIN_CONFIDENCE=0.85
