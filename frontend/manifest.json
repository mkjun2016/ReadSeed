{
  "manifest_version": 3,
  "name": "ReadSeed",
  "version": "0.2.0",
  "description": "발음·쉬운 뜻·핵심 정보·동시 읽기를 제공하는 한국어 읽기 보조 확장 프로그램",
  "action": {
    "default_title": "ReadSeed",
    "default_popup": "popup/popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
